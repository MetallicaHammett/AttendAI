# Backend Configuration
# Address for `python -m app.main` (the uvicorn command passes --host itself). Loopback only;
# 0.0.0.0 would expose the API to the whole network.
HOST=127.0.0.1
PORT=8000
DEBUG=True
# Required: development | test | production. Startup fails if missing.
# production additionally requires DEBUG=False and ENABLE_SYNTHETIC_CAMERA=False.
ENVIRONMENT=development
# Required in production (startup fails otherwise). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In development/test without a key, a random per-process key is used (logins reset on restart).
SECRET_KEY=
DATABASE_URL=sqlite:///./data/attendai.db

# Frontend Configuration
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000

# Video Processing
VIDEO_SOURCE=0  # 0 for default webcam, or path to video file
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS=30

# --- Settings added in 1.0 (all optional; defaults shown). Full list: docs/CONFIGURATION.md
# Never enable outside development: replaces an unopenable camera with labelled test frames
ENABLE_SYNTHETIC_CAMERA=False
# Local model file (never downloaded at runtime); relative to backend/
YOLO_MODEL_PATH=yolov8n.pt
# Video-file cameras must be inside this folder (relative to backend/)
VIDEO_FILES_DIR=data/videos
CAMERA_AUTO_RECONNECT=True
CAMERA_RECONNECT_MAX_DELAY_SECONDS=30
CAMERA_STALE_AFTER_SECONDS=5
# Face matching (L2 distance between 128-d encodings; lower = stricter). Calibrate with real footage.
FACE_MATCH_TOLERANCE=0.6
FACE_MATCH_AMBIGUITY_MARGIN=0.0
UNKNOWN_SAME_PERSON_DISTANCE=0.6
UNKNOWN_RESOLVE_KNOWN_DISTANCE=0.45
# Attendance decisions
ATTENDANCE_MIN_CONFIDENCE=70
ATTENDANCE_MIN_CONSECUTIVE_FRAMES=5
ATTENDANCE_DEFAULT_GRACE_MINUTES=10
ATTENDANCE_EARLY_ARRIVAL_MINUTES=15
ATTENDANCE_EARLY_DEPARTURE_MINUTES=10
# Accounts: self-registered users are always read-only viewers
ALLOW_SELF_REGISTRATION=False
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001